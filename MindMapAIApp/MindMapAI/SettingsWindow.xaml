<Window x:Class="MindMapAI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="380" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#242434"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#313244"/>
        <SolidColorBrush x:Key="AccentColor" Color="#89B4FA"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#A6E3A1"/>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55555E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimary}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и кнопка закрытия -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Настройки"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Закрыть"
                        AutomationProperties.HelpText="Закрыть окно настроек">
                    <TextBlock Text="✖" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </Grid>

            <!-- Статус автосохранения -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="8"
                    Padding="15,10"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{StaticResource SuccessColor}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="Автосохранение включено"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"/>
                </Grid>
            </Border>

            <!-- Размер шрифта -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Размер шрифта в редакторе"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="SmallFontBtn"
                                Content="Маленький (14px)"
                                Style="{StaticResource OptionButton}"
                                Margin="0,0,10,0"
                                Click="SmallFont_Click"
                                Width="140"/>
                        <Button x:Name="MediumFontBtn"
                                Content="Средний (16px)"
                                Style="{StaticResource OptionButton}"
                                Margin="0,0,10,0"
                                Click="MediumFont_Click"
                                Width="140"/>
                        <Button x:Name="LargeFontBtn"
                                Content="Большой (18px)"
                                Style="{StaticResource OptionButton}"
                                Click="LargeFont_Click"
                                Width="140"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Кнопка сохранения -->
            <Button Grid.Row="4"
                    Content="Сохранить и закрыть"
                    Width="160"
                    Height="35"
                    HorizontalAlignment="Right"
                    Background="{StaticResource AccentColor}"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SaveAndClose_Click"
                    AutomationProperties.Name="Сохранить настройки"
                    AutomationProperties.HelpText="Сохранить выбранные настройки и закрыть окно">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>