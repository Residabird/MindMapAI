<Window x:Class="MindMapAI.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика" Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="TextAccent" Color="#89B4FA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#313244"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#A6E3A1"/>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55555E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimary}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Статистика"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Закрыть"
                        AutomationProperties.HelpText="Закрыть окно статистики">
                    <TextBlock Text="✖" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Всего заметок" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TotalNotesCount" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextAccent}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Сегодня" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TodayCount" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="За неделю" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="WeekCount" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="За месяц" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="MonthCount" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Топ тегов" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <ItemsControl x:Name="TopTagsList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TagName}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NoteCount}"
                                               Foreground="{StaticResource TextAccent}" FontSize="13"
                                               FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
