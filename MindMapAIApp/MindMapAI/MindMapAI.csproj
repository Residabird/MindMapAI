    <Resource Include="Assets\Images\add-new-folder-icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\ai-helper-icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
